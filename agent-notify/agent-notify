#!/bin/bash

set -u
set -o pipefail

usage() {
  cat <<'USAGE'
Usage: agent-notify [--target mac|iphone|both] [--title TITLE] MESSAGE
       agent-notify logs

Send a notification to the Mac by default. Use --target iphone or --target both
only when the user requests those destinations. Each target attempt is appended
to ~/Library/Logs/agent-notifications.log.

Options:
  --target TARGET  mac (default), iphone, or both
  --title TITLE    Notification title (default: AI Agent)
  -h, --help       Show this help
  logs             Open the append-only notification log in less at the newest entry

Environment:
  AGENT_NOTIFY_ENV_FILE         Public Bark .env path (default: .env beside this helper)
  AGENT_NOTIFY_WORKER_ENV_FILE  Worker Bark env path (default: self.env beside this helper)
  AGENT_NOTIFY_LOG_FILE         Log path (default: ~/Library/Logs/agent-notifications.log)
USAGE
}

usage_error() {
  printf 'agent-notify: %s\n' "$1" >&2
  usage >&2
  exit 2
}

target='mac'
title='AI Agent'
message=''
message_set=0
show_logs=0

if [[ "${1:-}" == 'logs' ]]; then
  (($# == 1)) || usage_error 'logs does not accept additional arguments'
  show_logs=1
  shift
fi

while (($#)); do
  case "$1" in
    --target)
      (($# >= 2)) || usage_error 'missing value for --target'
      target=$2
      shift 2
      ;;
    --title)
      (($# >= 2)) || usage_error 'missing value for --title'
      title=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      (($# == 1)) || usage_error 'provide exactly one message'
      message=$1
      message_set=1
      shift
      ;;
    -* )
      usage_error "unknown option: $1"
      ;;
    *)
      ((message_set == 0)) || usage_error 'provide exactly one message'
      message=$1
      message_set=1
      shift
      ;;
  esac
done

if ((show_logs == 0)); then
  ((message_set == 1)) || usage_error 'message is required'
  [[ -n "$message" ]] || usage_error 'message must not be empty'
  [[ -n "$title" ]] || usage_error 'title must not be empty'
  case "$target" in
    mac|iphone|both) ;;
    *) usage_error "invalid target: $target" ;;
  esac
fi

script_dir=$(cd "$(dirname "$0")" && pwd -P) || {
  printf 'agent-notify: could not locate its skill directory\n' >&2
  exit 1
}
working_path=$(pwd -P) || working_path='(unknown)'
if [[ -n "${AGENT_NOTIFY_LOG_FILE:-}" ]]; then
  log_file=$AGENT_NOTIFY_LOG_FILE
else
  [[ -n "${HOME:-}" ]] || {
    printf 'agent-notify: HOME is unset; set AGENT_NOTIFY_LOG_FILE\n' >&2
    exit 1
  }
  log_file="$HOME/Library/Logs/agent-notifications.log"
fi

if ((show_logs == 1)); then
  if [[ ! -r "$log_file" ]]; then
    printf 'agent-notify: no notification log found at %s\n' "$log_file"
    exit 0
  fi
  if command -v less >/dev/null 2>&1; then
    exec less +G "$log_file"
  fi
  exec cat "$log_file"
fi

umask 077
log_dir=$(dirname "$log_file")
if ! mkdir -p "$log_dir" || ! exec 3>>"$log_file"; then
  printf 'agent-notify: cannot open notification log: %s\n' "$log_file" >&2
  exit 1
fi

record_attempt() {
  local attempted_target=$1
  local result=$2
  local timestamp
  timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || timestamp='unknown'
  printf '%s\nTimestamp: %s\nTarget: %s\nWorking directory: %s\nResult: %s\n\nTitle:\n%s\n\nMessage:\n%s\n--- end notification attempt ---\n\n' \
    '--- notification attempt ---' "$timestamp" "$attempted_target" "$working_path" \
    "$result" "$title" "$message" >&3
}

send_mac() {
  command -v terminal-notifier >/dev/null 2>&1 || return 1
  terminal-notifier -title "$title" -message "$message" -sound default >/dev/null 2>&1
}

trim() {
  local value=$1
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

read_bark_env_file() {
  local env_file=$1
  local require_server=$2
  local line name value quote
  local found_key=0
  local found_server=0
  BARK_KEY=''
  BARK_SERVER_URL=''

  [[ -r "$env_file" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line=$(trim "$line")
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == export[[:space:]]* ]]; then
      line=$(trim "${line#export}")
    fi
    [[ "$line" == *=* ]] || continue
    name=$(trim "${line%%=*}")
    case "$name" in
      BARK_KEY)
        ((found_key == 0)) || return 1
        ;;
      BARK_SERVER_URL)
        ((require_server == 1)) || continue
        ((found_server == 0)) || return 1
        ;;
      *)
        continue
        ;;
    esac
    value=$(trim "${line#*=}")
    if ((${#value} >= 2)); then
      quote=${value:0:1}
      if [[ ("$quote" == '"' || "$quote" == "'") && "${value: -1}" == "$quote" ]]; then
        value=${value:1:${#value}-2}
      fi
    fi
    [[ -n "$value" ]] || return 1
    case "$name" in
      BARK_KEY)
        [[ "$value" =~ ^[A-Za-z0-9._~-]+$ ]] || return 1
        BARK_KEY=$value
        found_key=1
        ;;
      BARK_SERVER_URL)
        value=${value%/}
        [[ "$value" =~ ^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]] || return 1
        BARK_SERVER_URL=$value
        found_server=1
        ;;
    esac
  done < "$env_file"

  ((found_key == 1)) || return 1
  if ((require_server == 1)); then
    ((found_server == 1)) || return 1
  fi
}

load_bark_config() {
  local public_env=${AGENT_NOTIFY_ENV_FILE:-"$script_dir/.env"}
  local worker_env=${AGENT_NOTIFY_WORKER_ENV_FILE:-"$script_dir/self.env"}
  PUBLIC_BARK_KEY=''
  WORKER_BARK_KEY=''
  WORKER_BARK_SERVER_URL=''

  if [[ -e "$worker_env" ]]; then
    read_bark_env_file "$worker_env" 1 || return 1
    WORKER_BARK_KEY=$BARK_KEY
    WORKER_BARK_SERVER_URL=$BARK_SERVER_URL
  fi

  if [[ -e "$public_env" ]]; then
    read_bark_env_file "$public_env" 0 || return 1
    PUBLIC_BARK_KEY=$BARK_KEY
  fi

  [[ -n "$WORKER_BARK_KEY" || -n "$PUBLIC_BARK_KEY" ]]
}

send_bark_request() {
  local server_url=$1
  local bark_key=$2
  # The Bark key is passed to curl through its config input, not its argv.
  printf 'url = "%s/%s"\n' "$server_url" "$bark_key" |
    curl -q --config - --silent --show-error --fail \
      --connect-timeout 5 --max-time 15 \
      --data-urlencode "title=$title" \
      --data-urlencode "body=$message" >/dev/null 2>&1
}

send_iphone() {
  local worker_exit=0
  local public_exit=0
  BARK_RESULT=''

  if ! load_bark_config; then
    BARK_RESULT='Bark credentials are missing or invalid'
    return 1
  fi
  if ! command -v curl >/dev/null 2>&1; then
    BARK_RESULT='curl is unavailable'
    return 1
  fi

  if [[ -n "$WORKER_BARK_KEY" ]]; then
    if send_bark_request "$WORKER_BARK_SERVER_URL" "$WORKER_BARK_KEY"; then
      BARK_RESULT='Worker succeeded'
      return 0
    else
      worker_exit=$?
    fi
  fi

  if [[ -n "$PUBLIC_BARK_KEY" ]]; then
    if send_bark_request 'https://api.day.app' "$PUBLIC_BARK_KEY"; then
      if [[ -n "$WORKER_BARK_KEY" ]]; then
        BARK_RESULT="Worker failed (curl exit $worker_exit); api.day.app fallback succeeded"
      else
        BARK_RESULT='api.day.app succeeded'
      fi
      return 0
    else
      public_exit=$?
    fi
  fi

  if [[ -n "$WORKER_BARK_KEY" && -n "$PUBLIC_BARK_KEY" ]]; then
    BARK_RESULT="Worker failed (curl exit $worker_exit); api.day.app fallback failed (curl exit $public_exit)"
  elif [[ -n "$WORKER_BARK_KEY" ]]; then
    BARK_RESULT="Worker failed (curl exit $worker_exit); public fallback key is missing"
  else
    BARK_RESULT="api.day.app failed (curl exit $public_exit)"
  fi
  return 1
}

if [[ "$target" == 'both' ]]; then
  targets=(mac iphone)
else
  targets=("$target")
fi

failed=0
for attempted_target in "${targets[@]}"; do
  case "$attempted_target" in
    mac)
      if send_mac; then
        if ! record_attempt mac 'command succeeded'; then
          printf 'agent-notify: Mac alert sent, but its log entry could not be appended\n' >&2
          failed=1
        fi
      else
        if ! record_attempt mac 'command failed'; then
          printf 'agent-notify: Mac failure could not be appended to the log\n' >&2
        fi
        printf 'agent-notify: Mac notification command failed\n' >&2
        failed=1
      fi
      ;;
    iphone)
      if send_iphone; then
        if ! record_attempt iphone "$BARK_RESULT"; then
          printf 'agent-notify: iPhone alert sent, but its log entry could not be appended\n' >&2
          failed=1
        fi
      else
        if ! record_attempt iphone "$BARK_RESULT"; then
          printf 'agent-notify: iPhone failure could not be appended to the log\n' >&2
        fi
        printf 'agent-notify: iPhone notification failed: %s\n' "$BARK_RESULT" >&2
        failed=1
      fi
      ;;
  esac
done

exit "$failed"
